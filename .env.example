# Environment for the root docker-compose.yml. Copy to .env (never commit .env):
#   cp .env.example .env
# Every value below is a LOCAL DEVELOPMENT placeholder. Use real secrets, from a secret
# store, for any shared or deployed environment. Passwords end up inside connection
# URLs, so keep them URL-safe (letters, digits, - _ .).

# -- Optional services (comma-separated): search, scraper, scraper-sharded, ui, tools
# e.g. COMPOSE_PROFILES=scraper,tools
COMPOSE_PROFILES=

# -- PostgreSQL: schema owner (migrations and seeding only) ------------------------
# Same values as database/.env.example, so host-side tools keep using
# DATABASE_URL=postgresql+psycopg://pgs:pgs@localhost:5432/pgs
POSTGRES_USER=pgs
POSTGRES_PASSWORD=pgs
POSTGRES_DB=pgs
POSTGRES_PORT=5432

# -- PostgreSQL: per-service login roles --------------------------------------------
# The roles are created by the migrations; db-roles sets these passwords.
PGS_API_DB_PASSWORD=pgs_api_dev
PGS_ETL_DB_PASSWORD=pgs_etl_dev
PGS_SEARCH_DB_PASSWORD=pgs_search_dev
PGS_SCRAPER_DB_PASSWORD=pgs_scraper_dev
# pgs_jobs: the scheduled pgs_db maintenance jobs (Airflow pgs_db_jobs_* DAGs).
PGS_JOBS_DB_PASSWORD=pgs_jobs_dev

# -- Airflow --------------------------------------------------------------------------
# Your Linux/WSL user id (`id -u`, usually 1000), so Airflow's files in ETL/airflow/logs
# belong to you.
AIRFLOW_UID=1000
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_SECRET_KEY=dummy_dev_secret_change_me
# Optional: encrypts connection passwords Airflow stores. Generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# AIRFLOW_WEBSERVER_WORKERS=2

# -- Host ports (all bound to 127.0.0.1) ----------------------------------------------
API_PORT=8000
# The UI directly (http://localhost:3000); normally use the nginx entry point below.
UI_PORT=3000
# The web entry point (nginx -> UI, profile `ui`): port 80 on every interface, so a
# domain pointed at this machine reaches it; 127.0.0.1 keeps it local.
HTTP_PORT=80
# HTTP_BIND_ADDRESS=0.0.0.0
AIRFLOW_PORT=8080
OPENSEARCH_PORT=9200
# Also the advertised host listener (localhost:<port>) the phase-1 Kafka scripts use.
KAFKA_PORT=9092
# CLAMAV_PORT=3310
# OPENSEARCH_DASHBOARDS_PORT=5601
# SEARCH_GRPC_PORT=50051
# TEMPORAL_PORT=7233
# TEMPORAL_UI_PORT=8233
# S3_PORT=4566
# S3_BROWSER_PORT=8081
# SCRAPER_API_PORT=8082
# SPARK_MASTER_UI_PORT=8090

# -- Memory (JVM heaps; local-development sizing) -------------------------------------
# OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
# KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

# -- API gateway ------------------------------------------------------------------------
# Signs the admin login tokens (HMAC-SHA256); at least 32 characters. Leave it empty and
# the API serves search/geo/health only (login and /api/v1/admin answer 503). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_AUTH_SECRET=
# API_TOKEN_TTL_SECONDS=28800
# SEARCH_TIMEOUT_SECONDS=8
# Browser origins allowed to call the API cross-origin (the UI goes through nginx and
# needs none), e.g. https://admin.example.np
# API_CORS_ORIGINS=

# -- Embeddings (ETL documents AND search queries; must be the same model + revision) --
# EMBEDDING_MODEL_NAME=sentence-transformers/LaBSE
# EMBEDDING_MODEL_REVISION=836121a0533e5664b21c7aacc5d22951f2b8b25b
# EMBEDDING_DIMENSIONS=768

# -- S3 (the crawl bucket). LocalStack accepts anything; for AWS set S3_ENDPOINT= (empty)
# S3_ENDPOINT=http://s3:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# AWS_REGION=us-east-1

# -- ETL --------------------------------------------------------------------------------
# Run the ETL once this many crawled-site events have arrived, or once the oldest has
# waited ETL_BATCH_MAX_WAIT_MINUTES; ETL_SITE_CONCURRENCY sites of a batch run at once.
# ETL_BATCH_SIZE=100
# ETL_BATCH_MAX_WAIT_MINUTES=60
# ETL_SITE_CONCURRENCY=4
# Spark standalone cluster (spark-master + SPARK_WORKERS x spark-worker).
# SPARK_WORKERS=2
# SPARK_WORKER_CORES=2
# SPARK_WORKER_MEMORY=2g
# SPARK_EXECUTOR_MEMORY=1g
# Pages of one site handled per Spark job (bounds the driver's memory per site).
# ETL_PAGE_GROUP_SIZE=200
# A site still failing after this many attempts (with ClamAV/PostgreSQL/S3 healthy) is
# dead-lettered to error_logs instead of blocking its batch.
# ETL_MAX_SITE_ATTEMPTS=5

# -- Search engine (profile search) ----------------------------------------------------
# The alias the engine queries and the indexer writes (index np_web_pages_v<N> behind it).
# OPENSEARCH_INDEX=np_web_pages
# Only when OpenSearch's security plugin is enabled (production):
# OPENSEARCH_SCHEME=https
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
# SEARCH_TRANSLATION_ENABLED=true
# TRANSLATION_MODEL_REVISION=f8d333a098d19b4fd9a8b18f94170487ad3f821d
# SEARCH_GRPC_WORKERS=8
# INDEXER_BATCH_SIZE=100

# -- Memory limits (docker compose deploy.resources.limits) ----------------------------
# OPENSEARCH_MEMORY_LIMIT=2g
# KAFKA_MEMORY_LIMIT=1g
# CLAMAV_MEMORY_LIMIT=2g
# SPARK_WORKER_MEMORY_LIMIT=3g
# ETL_WORKER_MEMORY_LIMIT=5g
# SEARCH_ENGINE_MEMORY_LIMIT=6g
# CHROME_MEMORY_LIMIT=2g

# -- Scraper (profiles scraper / scraper-sharded) -------------------------------------------
# Temporal's own PostgreSQL (not the application database).
TEMPORAL_DB_PASSWORD=temporal
# Airflow's scraper_crawl_schedule DAG crawls every website in `domains` on this cron
# schedule, with these per-website limits (revisit 0 = re-fetch every page each time).
# SCRAPER_CRAWL_SCHEDULE="*/30 * * * *"
# SCRAPER_MAX_PAGES_PER_DOMAIN=100
# SCRAPER_MAX_DEPTH=3
# SCRAPER_CONCURRENT_DOMAINS=20
# SCRAPER_MAX_CONCURRENT_PER_HOST=2
# Only crawl pages whose detected country matches (ISO 3166-1 alpha-2, e.g. NP); empty = all.
# SCRAPER_COUNTRY_FILTER=
# SCRAPER_REVISIT_AFTER_HOURS=0
# s3 | ndjson
# SCRAPER_STORAGE=s3
# off | auto | always
# SCRAPER_RENDER=auto
# Publish one event per crawled website to Kafka for the ETL (empty = S3 only).
# SCRAPER_KAFKA_BROKERS=kafka:29092
